<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{{ subject }}</title>
    <style>
      body {
        margin: 0; padding: 12px 20px;
        background-color: #ffffff;
        font-family: -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", "Malgun Gothic", sans-serif;
        color: #111;
        font-size: 14px;
        line-height: 1.5;
      }

      /* ── 상단 메타 ── */
      .top-meta {
        font-size: 12px;
        color: #888;
        margin-bottom: 12px;
        border-bottom: 2px solid #111;
        padding-bottom: 6px;
      }

      /* ── 섹션 ── */
      .section { margin-bottom: 20px; }

      .sec-header {
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 0.04em;
        margin-bottom: 8px;
        padding-bottom: 4px;
        border-bottom: 1px solid #ddd;
      }
      .sec-header-high   { color: #c00; border-color: #c00; }
      .sec-header-medium { color: #b45309; border-color: #b45309; }
      .sec-header-court  { color: #334155; border-color: #64748b; }
      .sec-header-low    { color: #888; border-color: #ccc; }

      /* ── 아이템 ── */
      .item {
        padding: 8px 0;
        border-bottom: 1px solid #f0f0f0;
      }
      .item:last-child { border-bottom: none; }

      /* ── 메타 줄 ── */
      .item-meta { margin-bottom: 2px; line-height: 1.6; }
      .tag {
        display: inline-block;
        padding: 1px 8px;
        border-radius: 2px;
        font-size: 12px;
        font-weight: 600;
        margin-right: 4px;
        vertical-align: middle;
      }
      .tag-source  { background-color: #e8f0fe; color: #1a56db; }
      .tag-kind    { background-color: #f3f0ff; color: #6c3fc7; }
      .tag-new     { background-color: #e6f4ea; color: #1b6b3a; }
      .tag-priority-high   { background-color: #fee2e2; color: #991b1b; }
      .tag-priority-medium { background-color: #fef3c7; color: #92400e; }
      .tag-priority-low    { background-color: #f3f4f6; color: #6b7280; }
      .item-date   { font-size: 12px; color: #aaa; vertical-align: middle; }

      /* ── 관련성 표시 (별만, 은은하게) ── */
      .star { color: #d97706; text-decoration: none; }

      /* ── 제목 ── */
      .item-title {
        display: block;
        font-size: 14px;
        font-weight: 600;
        color: #111;
        text-decoration: none;
        margin: 2px 0 4px;
        line-height: 1.4;
      }
      .item-title:hover { text-decoration: underline; }

      /* ── 요약 ── */
      .item-summary {
        font-size: 13px;
        color: #444;
        line-height: 1.6;
        margin-bottom: 3px;
        padding-left: 8px;
        border-left: 2px solid #ccc;
      }

      .item-relevance {
        font-size: 12px;
        color: #92400e;
        line-height: 1.5;
        margin: 2px 0 3px;
      }
      .item-deadlines { margin: 3px 0; font-size: 12px; color: #7c2d12; }
      .deadline { display: inline-block; margin-right: 8px; font-weight: 600; }

      /* ── 이유 (summary 없을 때) ── */
      .item-reason {
        font-size: 12px;
        color: #777;
        line-height: 1.5;
      }

      /* ── 첨부 ── */
      .item-attach {
        font-size: 12px;
        color: #aaa;
        margin-top: 2px;
      }
      .item-attach a { color: #1a56db; text-decoration: none; }

      /* ── 자식 아이템 ── */
      .child-list {
        list-style: none;
        margin: 6px 0 0;
        padding: 0 0 0 16px;
        border-left: 2px solid #e0e0e0;
      }
      .child-item { padding: 6px 0; border-bottom: 1px solid #f5f5f5; }
      .child-item:last-child { border-bottom: none; }

      /* ── 오류 ── */
      /* ── 푸터 ── */
      .footer { font-size: 12px; color: #bbb; margin-top: 24px; border-top: 1px solid #eee; padding-top: 8px; }
    /* Approved email refinement — 2026-11-09 */

body { width:100%; max-width:none; margin:0; padding:0; font-size:16px; line-height:1.75; }
.email-container { width:100%; max-width:1240px; margin:0 auto; table-layout:fixed; }
.email-content { padding:24px 28px 32px; overflow-wrap:anywhere; }
.top-meta { color:#59616b; font-size:12px; padding-bottom:10px; margin-bottom:24px; border-bottom:2px solid #20252b; }
.section { margin-bottom:28px; }
.sec-header { font-size:14px; letter-spacing:.02em; padding-bottom:7px; margin-bottom:4px; }
.sec-header-low { color:#59616b; }
.item { padding:15px 0 17px; border-bottom:1px solid #e7e9ed; }
.item-meta { margin-bottom:5px; line-height:1.8; }
.tag { font-size:11px; padding:1px 6px; font-weight:500; margin-right:3px; border-radius:3px; }
.tag-source { background:#edf3fc; color:#24508f; }
.tag-kind { background:#f3effa; color:#665083; }
.tag-new { background:#edf5ef; color:#356849; }
.item-date { font-size:12px; color:#68717e; }
.item-title { font-size:18px; font-weight:600; line-height:1.55; margin:3px 0 8px; overflow-wrap:anywhere; }
.item-summary { font-size:16px; color:#424a55; line-height:1.8; border-left:2px solid #d9dee5; padding-left:11px; margin:7px 0 9px; }
.item-relevance { font-size:12px; line-height:1.7; margin:4px 0 7px; }
.item-attach { font-size:12px; color:#697380; line-height:1.8; margin-top:7px; overflow-wrap:anywhere; }
.item-attach a { color:#345c91; text-decoration:underline; text-underline-offset:2px; }
.item-attach a+a { margin-left:8px; }
.item-deadlines { margin:6px 0; line-height:1.8; }
.child-list { padding-left:14px; margin:12px 0 2px; border-left:2px solid #e3e6eb; }
.child-item { padding:10px 0; }
.section-low .item { padding:10px 0; }
.section-low .item-title { font-size:16px; margin-bottom:3px; }
.footer { color:#68717e; padding-top:12px; margin-top:30px; }
a:focus-visible { outline:2px solid #24508f; outline-offset:3px; }
@media(max-width:520px) { .email-content { padding:16px 12px 24px !important; } .item-title { font-size:16px; } .tag { padding:1px 5px; } }

      .report-banner { margin:0 0 24px; padding:18px 20px; background:#eaf3fc; border:1px solid #bfd4e9; border-left:5px solid #245f8c; color:#183957; font-size:16px; line-height:1.8; }
      .report-banner-title { font-size:20px; font-weight:700; margin:0 0 6px; }
      .item-report { margin:14px 0; padding:16px 18px; background:#edf5fd; border:1px solid #bfd4e9; border-left:4px solid #245f8c; color:#183957; font-size:15px; line-height:1.8; overflow-wrap:anywhere; }
      .report-preview { display:block; width:100%; max-width:740px; height:auto; margin:12px 0 4px; border:1px solid #c8d7e7; }
      .report-fallback { font-size:14px; font-weight:600; color:#245f8c; }
    </style>
  </head>
  <body>
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;"><tr><td align="center">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" class="email-container" style="width:100%;max-width:1240px;margin:0 auto;table-layout:fixed;"><tr><td class="email-content" style="padding:24px 28px 32px;font-family:Arial,Malgun Gothic,sans-serif;font-size:16px;line-height:1.75;color:#111;">

    <div class="top-meta">
      {{ run_date[:10] }} &nbsp;·&nbsp; Legal &amp; Compliance Signal &nbsp;·&nbsp; 이번 회차 선별 항목
    </div>

    {% if report_attachments %}
      <div class="report-banner" style="margin:0 0 24px;padding:18px 20px;background:#eaf3fc;border:1px solid #bfd4e9;border-left:5px solid #245f8c;color:#183957;line-height:1.8;">
        <div class="report-banner-title" style="font-size:20px;font-weight:700;margin-bottom:6px;">상세 리포트 PDF {{ report_attachments|length }}건 첨부</div>
        {% for report in report_attachments %}
          <div><strong>{{ report.title or report.filename }}</strong></div>
          <div>첨부파일: {{ report.filename }}</div>
        {% endfor %}
        <div class="report-fallback">아래 이미지로 내용을 미리 보고, 전체 내용은 메일에 첨부된 PDF에서 확인해 주세요.</div>
      </div>
    {% endif %}

    {% for sec in sections %}
      {% if sec.items|length > 0 %}
        {% set sec_key = sec.label | lower %}
        <div class="section section-{{ sec_key }}">

          <div class="sec-header sec-header-{{ sec_key }}">
            {%- if sec_key == 'high' -%}▲ HIGH
            {%- elif sec_key == 'medium' -%}◆ MEDIUM
            {%- elif sec_key == 'court' -%}▣ 대법원 주요판결
            {%- else -%}● LOW
            {%- endif -%}
            &nbsp;<span style="font-weight:400; font-size:12px;">({{ sec.items|length }}건)</span>
          </div>

          {% for it in sec.items %}
            <div class="item">

              <div class="item-meta">
                <span class="tag tag-source">{{ it.source_name_ko }}</span>
                <span class="tag tag-kind">{{ it.category_label }}</span>
                {% if it.item_id and not it.is_updated %}
                  <span class="tag tag-new">신규</span>
                {% endif %}
                {% if it.published_at %}
                  <span class="item-date">{{ it.published_at }}</span>
                {% endif %}
              </div>

              <a class="item-title" href="{{ it.url }}">{% if it.company_flag %}<span class="star" title="{{ it.relevance_evidence }}">★</span> {% endif %}{{ it.title }}</a>

              {% if it.company_flag and it.relevance_evidence %}
                <div class="item-relevance">★ 당사 관련: {{ it.relevance_evidence }}</div>
              {% endif %}
              {% if it.deadlines|length > 0 %}
                <div class="item-deadlines">
                  {% for deadline in it.deadlines %}
                    <span class="deadline deadline-{{ deadline.urgency }}">{{ deadline.label }} {{ deadline.date }}</span>
                  {% endfor %}
                </div>
              {% endif %}

              {% if it.summary %}
                <div class="item-summary">{% for line in it.summary.split(' / ') %}{{ line }}{% if not loop.last %}<br />{% endif %}{% endfor %}</div>
              {% elif it.reason %}
                <div class="item-reason">{{ it.reason }}</div>
              {% endif %}

              {% if it.report_files %}<div class="item-report" style="margin:14px 0;padding:16px 18px;background:#edf5fd;border:1px solid #bfd4e9;border-left:4px solid #245f8c;color:#183957;font-size:15px;line-height:1.8;"><strong>이 항목의 상세 리포트 PDF가 첨부되어 있습니다.</strong><br />{% for name in it.report_files %}{{ name }}{% if not loop.last %} · {% endif %}{% endfor %}<br />메일에 첨부된 PDF를 확인해 주세요.
                {% for preview in it.report_previews %}<img class="report-preview" src="cid:{{ preview.cid }}" alt="{{ preview.title }} — PDF 상단 미리보기. 이미지가 보이지 않으면 첨부 PDF를 확인해 주세요." width="740" style="display:block;width:100%;max-width:740px;height:auto;" /><span style="font-size:12px;">PDF 첫 페이지 상단 미리보기 · 전체 내용은 첨부파일 확인</span>{% endfor %}
              </div>{% endif %}
              {% if it.attachments|length > 0 %}
                <div class="item-attach">
                  첨부:
                  {% for a in it.attachments | compact_attachments %}
                    <a href="{{ a.url }}" title="{{ a.label }}" aria-label="{{ a.label }}">{{ a.display }}</a>{% if not loop.last %} · {% endif %}
                  {% endfor %}
                </div>
              {% endif %}

              {% if it.child_items|length > 0 %}
                <ul class="child-list">
                  {% for child in it.child_items %}
                    <li class="child-item">
                      <div class="item-meta">
                        <span class="tag tag-source">{{ child.source_name_ko }}</span>
                        <span class="tag tag-kind">{{ child.category_label }}</span>
                        {% if sec_key == 'court' %}<span class="tag tag-priority-{{ child.importance }}">{{ child.importance | upper }}</span>{% endif %}
                        {% if not child.is_updated %}
                          <span class="tag tag-new">신규</span>
                        {% endif %}
                        {% if child.published_at %}<span class="item-date">{{ child.published_at }}</span>{% endif %}
                      </div>
                      <a class="item-title" href="{{ child.url }}">{% if child.company_flag %}<span class="star" title="{{ child.relevance_evidence }}">★</span> {% endif %}{{ child.title }}</a>
                      {% if child.company_flag and child.relevance_evidence %}<div class="item-relevance">★ 당사 관련: {{ child.relevance_evidence }}</div>{% endif %}
                      {% if child.deadlines|length > 0 %}<div class="item-deadlines">{% for deadline in child.deadlines %}<span class="deadline deadline-{{ deadline.urgency }}">{{ deadline.label }} {{ deadline.date }}</span>{% endfor %}</div>{% endif %}
                      {% if child.summary %}
                        <div class="item-summary">{% for line in child.summary.split(' / ') %}{{ line }}{% if not loop.last %}<br />{% endif %}{% endfor %}</div>
                      {% elif child.reason %}
                        <div class="item-reason">{{ child.reason }}</div>
                      {% endif %}
                      {% if child.report_files %}<div class="item-report" style="margin:14px 0;padding:16px 18px;background:#edf5fd;border:1px solid #bfd4e9;border-left:4px solid #245f8c;color:#183957;font-size:15px;line-height:1.8;"><strong>이 항목의 상세 리포트 PDF가 첨부되어 있습니다.</strong><br />{% for name in child.report_files %}{{ name }}{% if not loop.last %} · {% endif %}{% endfor %}<br />메일에 첨부된 PDF를 확인해 주세요.
                        {% for preview in child.report_previews %}<img class="report-preview" src="cid:{{ preview.cid }}" alt="{{ preview.title }} — PDF 상단 미리보기. 첨부 PDF 확인" width="740" style="display:block;width:100%;max-width:740px;height:auto;" />{% endfor %}
                      </div>{% endif %}
                      {% if child.attachments|length > 0 %}
                        <div class="item-attach">
                          첨부:
                          {% for a in child.attachments | compact_attachments %}
                            <a href="{{ a.url }}" title="{{ a.label }}" aria-label="{{ a.label }}">{{ a.display }}</a>{% if not loop.last %} · {% endif %}
                          {% endfor %}
                        </div>
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}

            </div>
          {% endfor %}

        </div>
      {% endif %}
    {% endfor %}

    <div class="footer">미래에셋생명보험 법무·컴플라이언스팀 내부 브리핑</div>

    </td></tr></table></td></tr></table>
  </body>
</html>
