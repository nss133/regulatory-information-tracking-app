<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{{ subject }}</title>
    <style>
      body {
        margin: 0; padding: 12px 20px;
        background-color: #ffffff;
        font-family: -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", "Malgun Gothic", sans-serif;
        color: #111;
        font-size: 14px;
        line-height: 1.5;
      }

      /* ── 상단 메타 ── */
      .top-meta {
        font-size: 12px;
        color: #888;
        margin-bottom: 12px;
        border-bottom: 2px solid #111;
        padding-bottom: 6px;
      }

      /* ── 섹션 ── */
      .section { margin-bottom: 20px; }

      .sec-header {
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 0.04em;
        margin-bottom: 8px;
        padding-bottom: 4px;
        border-bottom: 1px solid #ddd;
      }
      .sec-header-high   { color: #c00; border-color: #c00; }
      .sec-header-medium { color: #b45309; border-color: #b45309; }
      .sec-header-court  { color: #334155; border-color: #64748b; }
      .sec-header-low    { color: #888; border-color: #ccc; }

      /* ── 아이템 ── */
      .item {
        padding: 8px 0;
        border-bottom: 1px solid #f0f0f0;
      }
      .item:last-child { border-bottom: none; }

      /* ── 메타 줄 ── */
      .item-meta { margin-bottom: 2px; line-height: 1.6; }
      .tag {
        display: inline-block;
        padding: 1px 8px;
        border-radius: 2px;
        font-size: 12px;
        font-weight: 600;
        margin-right: 4px;
        vertical-align: middle;
      }
      .tag-source  { background-color: #e8f0fe; color: #1a56db; }
      .tag-kind    { background-color: #f3f0ff; color: #6c3fc7; }
      .tag-new     { background-color: #e6f4ea; color: #1b6b3a; }
      .tag-priority-high   { background-color: #fee2e2; color: #991b1b; }
      .tag-priority-medium { background-color: #fef3c7; color: #92400e; }
      .tag-priority-low    { background-color: #f3f4f6; color: #6b7280; }
      .item-date   { font-size: 12px; color: #aaa; vertical-align: middle; }

      /* ── 관련성 표시 (별만, 은은하게) ── */
      .star { color: #d97706; text-decoration: none; }

      /* ── 제목 ── */
      .item-title {
        display: block;
        font-size: 14px;
        font-weight: 600;
        color: #111;
        text-decoration: none;
        margin: 2px 0 4px;
        line-height: 1.4;
      }
      .item-title:hover { text-decoration: underline; }

      /* ── 요약 ── */
      .item-summary {
        font-size: 13px;
        color: #444;
        line-height: 1.6;
        margin-bottom: 3px;
        padding-left: 8px;
        border-left: 2px solid #ccc;
      }

      .item-relevance {
        font-size: 12px;
        color: #92400e;
        line-height: 1.5;
        margin: 2px 0 3px;
      }
      .item-deadlines { margin: 3px 0; font-size: 12px; color: #7c2d12; }
      .deadline { display: inline-block; margin-right: 8px; font-weight: 600; }

      /* ── 이유 (summary 없을 때) ── */
      .item-reason {
        font-size: 12px;
        color: #777;
        line-height: 1.5;
      }

      /* ── 첨부 ── */
      .item-attach {
        font-size: 12px;
        color: #aaa;
        margin-top: 2px;
      }
      .item-attach a { color: #1a56db; text-decoration: none; }

      /* ── 자식 아이템 ── */
      .child-list {
        list-style: none;
        margin: 6px 0 0;
        padding: 0 0 0 16px;
        border-left: 2px solid #e0e0e0;
      }
      .child-item { padding: 6px 0; border-bottom: 1px solid #f5f5f5; }
      .child-item:last-child { border-bottom: none; }

      /* ── 오류 ── */
      /* ── 푸터 ── */
      .footer { font-size: 12px; color: #bbb; margin-top: 24px; border-top: 1px solid #eee; padding-top: 8px; }

/* PDF 첨부 안내 외의 글꼴·간격·본문 폭은 11/9 최초 발송 서식을 사용한다. */
.email-container { width:100%; margin:0; table-layout:fixed; }
.email-content { padding:0; overflow-wrap:anywhere; }
.item-report { margin:10px 0; padding:12px 14px; background:#edf5fd; border:1px solid #bfd4e9; border-left:4px solid #245f8c; color:#183957; font-size:13px; line-height:1.6; overflow-wrap:anywhere; }
.report-preview { display:block; width:100%; max-width:740px; height:auto; margin:10px 0 4px; border:1px solid #c8d7e7; }

/* 주요 항목만 참고자료를 오른쪽에 배치한다. LOW의 본문·첨부 배치는 유지한다. */
.story-table { width:100%; table-layout:fixed; border-collapse:collapse; }
.main-story { width:68%; vertical-align:top; padding:0 20px 0 0; }
.reference-rail { width:32%; vertical-align:top; padding:0 0 0 18px; border-left:1px solid #dce3eb; font-size:12px; line-height:1.6; }
.ref-head { font-weight:600; color:#42556a; margin-bottom:5px; }
.ref-group + .ref-group { margin-top:12px; }
.reference-rail a { color:#245f8c; text-decoration:underline; overflow-wrap:anywhere; }
.ref-meta,.ref-why { color:#5e6b78; margin-top:3px; }
.item-stage { font-size:12px; color:#965409; margin:3px 0 5px; }
a:focus-visible { outline:2px solid #245f8c; outline-offset:3px; }
@media screen and (max-width:760px) {
 .story-table,.story-table>tbody,.story-table>tbody>tr,.story-table>tbody>tr>td { display:block!important; width:100%!important; box-sizing:border-box; }
 .main-story { padding-right:0!important; }
 .reference-rail { margin-top:10px; padding:9px 0 0!important; border-left:0!important; border-top:1px solid #dce3eb; }
}
</style>
  </head>
  <body>
    {% macro references(it) -%}
      {% if it.attachments %}<div class="ref-group"><div class="ref-head">첨부자료</div>
        {% for a in it.attachments | reference_attachments %}<div><a href="{{ a.url }}" title="{{ a.label }}" aria-label="{{ a.label }}" style="color:#245f8c;text-decoration:underline;">{{ a.display }}</a></div>{% endfor %}
      </div>{% endif %}
      {% if it.issue_items %}<div class="ref-group"><div class="ref-head">같은 사안 자료</div>
        {% for linked in it.issue_items %}{% if linked.url != it.url %}<div><a href="{{ linked.url }}" style="color:#245f8c;text-decoration:underline;">{{ linked.title }}</a></div><div class="ref-meta">{{ linked.source_name_ko }}{% if linked.published_at %} · {{ linked.published_at }}{% endif %}</div>{% endif %}{% endfor %}
      </div>{% endif %}
      {% if it.related_articles %}<div class="ref-group"><div class="ref-head">관련 보도</div>
        {% for a in it.related_articles %}<div><a href="{{ a.url }}" style="color:#245f8c;text-decoration:underline;">{{ a.title }}</a></div><div class="ref-meta">{{ a.publisher }} · {{ a.published_at }}</div><div class="ref-why">읽을 이유: {{ a.why_read }}</div>{% endfor %}
      </div>{% endif %}
    {%- endmacro %}

    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;"><tr><td align="center">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" class="email-container" style="width:100%;margin:0;table-layout:fixed;"><tr><td class="email-content" style="padding:0;font-family:-apple-system,BlinkMacSystemFont,Apple SD Gothic Neo,Malgun Gothic,sans-serif;font-size:14px;line-height:1.5;color:#111;">

    <div class="top-meta">
      {{ run_date[:10] }} &nbsp;·&nbsp; Legal &amp; Compliance Signal &nbsp;·&nbsp; 이번 회차 선별 항목
    </div>

    {% for sec in sections %}
      {% if sec.items|length > 0 %}
        {% set sec_key = sec.label | lower %}
        <div class="section section-{{ sec_key }}">

          <div class="sec-header sec-header-{{ sec_key }}">
            {%- if sec_key == 'high' -%}▲ HIGH
            {%- elif sec_key == 'medium' -%}◆ MEDIUM
            {%- elif sec_key == 'court' -%}▣ 대법원 주요판결
            {%- else -%}● LOW
            {%- endif -%}
            &nbsp;<span style="font-weight:400; font-size:12px;">{% if sec.source_count is defined and sec.source_count > sec.items|length %}({{ sec.items|length }}개 사안 · 원문 {{ sec.source_count }}건){% else %}({{ sec.items|length }}건){% endif %}</span>
          </div>

          {% for it in sec.items %}
            <div class="item">
              {% set split_refs = sec_key != 'low' and (it.attachments or it.issue_items or it.related_articles) %}
              {% if split_refs %}<table role="presentation" class="story-table" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;table-layout:fixed;"><tr><td class="main-story" width="68%" style="width:68%;vertical-align:top;padding-right:20px;">{% endif %}

              <div class="item-meta">
                <span class="tag tag-source">{{ it.source_name_ko }}</span>
                <span class="tag tag-kind">{{ it.category_label }}</span>
                {% if it.item_id and not it.is_updated %}
                  <span class="tag tag-new">신규</span>
                {% endif %}
                {% if it.published_at %}
                  <span class="item-date">{{ it.published_at }}</span>
                {% endif %}
              </div>

              <a class="item-title" href="{{ it.url }}">{% if it.company_flag %}<span class="star" title="{{ it.relevance_evidence }}">★</span> {% endif %}{{ it.title }}</a>
              {% if it.stage %}<div class="item-stage">{{ it.stage }}</div>{% endif %}

              {% if it.company_flag and it.relevance_evidence %}
                <div class="item-relevance">★ 당사 관련: {{ it.relevance_evidence }}</div>
              {% endif %}
              {% if it.deadlines|length > 0 %}
                <div class="item-deadlines">
                  {% for deadline in it.deadlines %}
                    <span class="deadline deadline-{{ deadline.urgency }}">{{ deadline.label }} {{ deadline.date }}</span>
                  {% endfor %}
                </div>
              {% endif %}

              {% if it.summary %}
                <div class="item-summary">{% for line in it.summary.split(' / ') %}{{ line }}{% if not loop.last %}<br />{% endif %}{% endfor %}</div>
              {% elif it.reason %}
                <div class="item-reason">{{ it.reason }}</div>
              {% endif %}

              {% if it.report_files %}<div class="item-report" style="margin:10px 0;padding:12px 14px;background:#edf5fd;border:1px solid #bfd4e9;border-left:4px solid #245f8c;color:#183957;font-size:13px;line-height:1.6;"><strong>이 항목의 상세 리포트 PDF가 첨부되어 있습니다.</strong><br />{% for name in it.report_files %}{{ name }}{% if not loop.last %} · {% endif %}{% endfor %}
                {% for preview in it.report_previews %}<details class="report-preview-toggle" style="margin-top:8px;"><summary style="cursor:pointer;color:#245f8c;font-size:13px;font-weight:600;">PDF 미리보기 펼치기 / 접기</summary><img class="report-preview" src="cid:{{ preview.cid }}" alt="{{ preview.title }} — PDF 상단 미리보기. 첨부 PDF 확인" width="740" style="display:block;width:100%;max-width:740px;height:auto;" /><span style="font-size:12px;">PDF 첫 페이지 상단 미리보기 · 전체 내용은 첨부파일 확인</span></details>{% endfor %}
              </div>{% endif %}
              {% if it.attachments|length > 0 and not split_refs %}
                <div class="item-attach">
                  첨부:
                  {% for a in it.attachments | compact_attachments %}
                    <a href="{{ a.url }}" title="{{ a.label }}" aria-label="{{ a.label }}">{{ a.display }}</a>{% if not loop.last %} · {% endif %}
                  {% endfor %}
                </div>
              {% endif %}

              {% if split_refs %}</td><td class="reference-rail" width="32%" style="width:32%;vertical-align:top;padding-left:18px;border-left:1px solid #dce3eb;font-size:12px;line-height:1.6;">{{ references(it) }}</td></tr></table>{% endif %}
              {% if it.child_items|length > 0 %}
                <ul class="child-list">
                  {% for child in it.child_items %}
                    <li class="child-item">
                      {% set child_refs = sec_key != 'low' and (child.attachments or child.issue_items or child.related_articles) %}
                      {% if child_refs %}<table role="presentation" class="story-table" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;table-layout:fixed;"><tr><td class="main-story" width="68%" style="width:68%;vertical-align:top;padding-right:20px;">{% endif %}
                      <div class="item-meta">
                        <span class="tag tag-source">{{ child.source_name_ko }}</span>
                        <span class="tag tag-kind">{{ child.category_label }}</span>
                        {% if sec_key == 'court' %}<span class="tag tag-priority-{{ child.importance }}">{{ child.importance | upper }}</span>{% endif %}
                        {% if not child.is_updated %}
                          <span class="tag tag-new">신규</span>
                        {% endif %}
                        {% if child.published_at %}<span class="item-date">{{ child.published_at }}</span>{% endif %}
                      </div>
                      <a class="item-title" href="{{ child.url }}">{% if child.company_flag %}<span class="star" title="{{ child.relevance_evidence }}">★</span> {% endif %}{{ child.title }}</a>
                      {% if child.stage %}<div class="item-stage">{{ child.stage }}</div>{% endif %}
                      {% if child.company_flag and child.relevance_evidence %}<div class="item-relevance">★ 당사 관련: {{ child.relevance_evidence }}</div>{% endif %}
                      {% if child.deadlines|length > 0 %}<div class="item-deadlines">{% for deadline in child.deadlines %}<span class="deadline deadline-{{ deadline.urgency }}">{{ deadline.label }} {{ deadline.date }}</span>{% endfor %}</div>{% endif %}
                      {% if child.summary %}
                        <div class="item-summary">{% for line in child.summary.split(' / ') %}{{ line }}{% if not loop.last %}<br />{% endif %}{% endfor %}</div>
                      {% elif child.reason %}
                        <div class="item-reason">{{ child.reason }}</div>
                      {% endif %}
                      {% if child.report_files %}<div class="item-report" style="margin:10px 0;padding:12px 14px;background:#edf5fd;border:1px solid #bfd4e9;border-left:4px solid #245f8c;color:#183957;font-size:13px;line-height:1.6;"><strong>이 항목의 상세 리포트 PDF가 첨부되어 있습니다.</strong><br />{% for name in child.report_files %}{{ name }}{% if not loop.last %} · {% endif %}{% endfor %}
                {% for preview in child.report_previews %}<details class="report-preview-toggle" style="margin-top:8px;"><summary style="cursor:pointer;color:#245f8c;font-size:13px;font-weight:600;">PDF 미리보기 펼치기 / 접기</summary><img class="report-preview" src="cid:{{ preview.cid }}" alt="{{ preview.title }} — PDF 상단 미리보기. 첨부 PDF 확인" width="740" style="display:block;width:100%;max-width:740px;height:auto;" /><span style="font-size:12px;">PDF 첫 페이지 상단 미리보기 · 전체 내용은 첨부파일 확인</span></details>{% endfor %}
              </div>{% endif %}
                      {% if child.attachments|length > 0 and not child_refs %}
                        <div class="item-attach">
                          첨부:
                          {% for a in child.attachments | compact_attachments %}
                            <a href="{{ a.url }}" title="{{ a.label }}" aria-label="{{ a.label }}">{{ a.display }}</a>{% if not loop.last %} · {% endif %}
                          {% endfor %}
                        </div>
                      {% endif %}
                      {% if child_refs %}</td><td class="reference-rail" width="32%" style="width:32%;vertical-align:top;padding-left:18px;border-left:1px solid #dce3eb;font-size:12px;line-height:1.6;">{{ references(child) }}</td></tr></table>{% endif %}
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}

            </div>
          {% endfor %}

        </div>
      {% endif %}
    {% endfor %}

    <div class="footer">미래에셋생명보험 법무·컴플라이언스팀 내부 브리핑</div>

    </td></tr></table></td></tr></table>
  </body>
</html>
